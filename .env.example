# --- Telegram API Credentials (Required) ---
API_ID=12345678
API_HASH=your_api_hash_here
TOKEN=your_bot_token_here

# --- MongoDB Database (Required) ---
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
BACKUP_MONGO_URL=
DB_NAME=aoiwaifu

# --- Owner & Sudo Admins ---
OWNER_ID=123456789
OWNER_USERNAME=your_username
SUDO=123456789

# --- Channels & Support Links ---
GLOG=your_log_channel_username_or_id
CHARA_CHANNEL_ID=your_character_channel_username_or_id
SUPPORT_CHAT_ID=-1001234567890
SUPPORT_CHAT=https://t.me/your_support_group
UPDATE_CHAT=https://t.me/your_update_channel

# --- ImgBB API Keys for /gupload & /reupload (comma-separated supported) ---
